# Optional runtime configuration. Demo mode is fully offline and needs no secrets.
TERRASEEK_MODE=demo
TERRASEEK_LOG_LEVEL=INFO
TERRASEEK_API_PREFIX=/api/v1
# Public STAC catalog used by the live catalog/search endpoint.
TERRASEEK_STAC_URL=https://earth-search.aws.element84.com/v1
# Set these only for deployed environments.
# TERRASEEK_API_KEY=replace-me
# TERRASEEK_SIGNING_KEY=replace-with-a-long-random-secret
# TERRASEEK_DB_PATH=terraseek.db
